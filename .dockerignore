# Cache directories
.cache/

# Exclude the bulky generated data in out/, but keep the files that Rust
# builds or MCP need: rkyv packs are loaded from disk by yap-mcp; hash and
# showcase files are embedded by yap-frontend-rs (a dependency of yap-mcp).
out/**/*.jsonl
out/**/*.json
out/**/*.hash
!out/**/language_data.hash
!out/**/showcase.json

# Rust build artifacts
target/

# Version control
.git/
.gitignore
.gitattributes

# Frontend (not needed for ai-backend)
yap-frontend/
static-site/
supabase/
modal-llm-server/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Other
node_modules/
yap-mcp/widget/node_modules/
dist/
tmp/
logs/
*.log
test-data/
*.mp4
*.mov
*.zip
*.tar.gz
.github/
scripts/
